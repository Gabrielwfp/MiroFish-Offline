# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# Runs entirely on local models via Ollama — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
# Ollama runs natively on the host (macOS app / `ollama serve`), not in compose.
# =============================================================

# ===== LLM (chat) — OpenAI-compatible endpoint of Ollama =====
# Ollama ignores the API key, but the app requires a non-empty value.
# The model must be pulled (`ollama list`). Structured NER uses Ollama's
# JSON-schema outputs, verified with Ollama >= 0.40.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=ornith-1.5:9b-mirofish-ctx32k
# LLM_MODEL_NAME=qwen3.8:27b-dflash2-nvfp4

# ===== Transport and context window =====
# LLM_API_MODE=openai         -> OpenAI-compatible /v1 (default; any provider). num_ctx can't be sent.
# LLM_API_MODE=ollama_native  -> Ollama /api/chat with options.num_ctx per operation.
#   num_ctx is only honored by Ollama's llama.cpp runner (GGUF models). The MLX runner
#   (safetensors models such as qwen3.8:27b-*-nvfp4/mxfp8) ignores it on every API
#   (ollama/ollama#18125); there, memory grows with the tokens actually processed.
# Requests are checked before sending (estimated input + output reserve <= num_ctx);
# anything that does not fit fails with ContextOverflowError instead of being truncated.
# LLM_API_MODE=ollama_native
# OLLAMA_NUM_CTX_DEFAULT=32768
# Per operation (unset -> default). Ontology/sim-config prompts reach ~11k input tokens
# plus up to 8k output, so keep them at 32768; profiles fit in 16384. NER, report and
# chat can run while the simulation does, so keep them equal to the simulation model's
# num_ctx to avoid reloading the model.
# OLLAMA_NUM_CTX_ONTOLOGY=32768
# OLLAMA_NUM_CTX_NER=32768
# OLLAMA_NUM_CTX_PROFILE=16384
# OLLAMA_NUM_CTX_SIM_CONFIG=32768
# OLLAMA_NUM_CTX_REPORT=32768
# OLLAMA_NUM_CTX_CHAT=32768
# Conservative chars-per-token ratio used by the preflight estimate (measured 4.0-5.5)
# CONTEXT_CHARS_PER_TOKEN=3.5

# ===== Simulation agents (CAMEL/OASIS, always /v1, cannot send num_ctx) =====
# Point them at an Ollama model derived with `PARAMETER num_ctx`, so /v1 loads it at that
# context instead of the server default (OLLAMA_CONTEXT_LENGTH):
#   printf 'FROM ornith-1.5:9b\nPARAMETER num_ctx 32768\n' > Modelfile
#   ollama create ornith-1.5:9b-mirofish-ctx32k -f Modelfile
# Use the same derived model as LLM_MODEL_NAME so app and simulation share one loaded instance.
# SIMULATION_LLM_MODEL_NAME=ornith-1.5:9b-mirofish-ctx32k
# Turn off thinking for simulation agents (posts and report interviews)
# SIMULATION_DISABLE_THINKING=false

# ===== Neo4j Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embeddings — independent from the chat settings =====
# OpenAI-compatible /v1/embeddings (the base URL must include /v1).
# EMBEDDING_API_KEY defaults to LLM_API_KEY when unset.
# EMBEDDING_DIMENSIONS must equal the model's output size; it also sizes the Neo4j
# vector indexes and every response is checked against it. Changing it on an
# existing Neo4j database requires dropping the old indexes (entity_embedding,
# fact_embedding) and re-embedding — see docs/ollama-integration-report.md.
#   qwen3-embedding:0.6b -> 1024      nomic-embed-text -> 768
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL, but the simulation scripts
# overwrite both with LLM_API_KEY / LLM_BASE_URL whenever those are set
# (backend/scripts/run_*_simulation.py). These are only a fallback.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Docker-mode overrides =====
# When the app runs in the compose container, Ollama is on the host:
# use host.docker.internal (compose maps it via host-gateway, so it works on Linux too)
# and reach neo4j by its service name.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_BASE_URL=http://host.docker.internal:11434/v1
# NEO4J_URI=bolt://neo4j:7687
